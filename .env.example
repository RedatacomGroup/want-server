NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Local development uses the Render External Database URL.
# Paste the NEW URL after rotating the exposed database credentials.
DATABASE_URL=

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECTION_TIMEOUT_MS=30000

# Local Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# Request body limits.
JSON_BODY_LIMIT=1mb

# HTTP logging.
HTTP_LOG_FORMAT=dev

# Graceful server shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# Generate two separate secrets using the command below.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=want-server
JWT_AUDIENCE=want-web

STORAGE_PROVIDER=cloudinary

PUBLIC_API_URL=http://localhost:4000
LOCAL_UPLOAD_DIR=uploads

MAX_IMAGE_BYTES=8388608
DESIRE_AUTO_PUBLISH=true

CLOUDINARY_URL=

RATE_LIMIT_GENERAL_PER_MINUTE=240
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_15_MIN=20
RATE_LIMIT_REFRESH_PER_5_MIN=60
RATE_LIMIT_DESIRE_CREATE_PER_10_MIN=30
RATE_LIMIT_SWIPES_PER_MINUTE=180

TEST_API_BASE_URL=http://localhost:4000

TEST_OWNER_IDENTIFIER=
TEST_OWNER_PASSWORD=

TEST_VIEWER_IDENTIFIER=
TEST_VIEWER_PASSWORD=

TEST_DESIRE_ID=